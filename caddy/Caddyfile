# Reverse proxy for the error monitoring pipeline — IP/port based, no
# domain or DNS required. Works the same whether you're running this on
# localhost or on a VPS reached only by its public IP address.
#
#   GlitchTip (errors):        http://<host>:8000
#   Feedback/incident receiver: http://<host>:4000
#
# "<host>" is whatever reaches the machine this is running on:
# `localhost` locally, or the server's public IP once you upload it there.
# Nothing here needs to change between those two cases.
#
# This intentionally stays plain HTTP: getting a browser-trusted cert for
# a bare IP isn't possible (Let's Encrypt requires a domain), and traffic
# is expected to stay inside a private network / behind the server's
# firewall. If you later point a real domain at this server, see the
# commented-out block at the bottom for automatic HTTPS.

:8000 {
	# One origin, two backends behind it.
	#
	# Sentinel used to live on its own port, which meant a second origin and
	# everything that follows from that: CORS on every call, cookies reasoned
	# about per port, and two apps where there should be one. Serving it here
	# means a browser signed in to GlitchTip can call GlitchTip's own API
	# directly, with the session it already has, and Sentinel is a path rather
	# than a separate address.
	#
	# Order matters, and after Phase 9 it decides the whole shape of the
	# origin: GlitchTip keeps the paths that are backend, and Sentinel gets
	# everything a person can type or follow from an email.
	#
	# Only the path apps' SDKs post to. Everything else under /api is
	# GlitchTip's — including /api/settings/, which the shell reads before
	# anything else, and /api/<project-id>/ where events arrive.
	# Exact, not a prefix wildcard: /api/reports* would also capture anything
	# GlitchTip might serve beginning with those letters.
	@report_intake path /api/reports /api/reports/*
	handle @report_intake {
		reverse_proxy feedback-receiver:4000
	}

	# What GlitchTip still answers for.
	#
	# Written out one prefix at a time rather than as "everything except the
	# UI", because the two backends have to agree about this list and a
	# wildcard with holes in it is a rule nobody can check. Each line is a
	# real Django route (glitchtip/urls.py), and each is here for a reason
	# that outlives the Angular app:
	#
	#   /api/          its whole API, plus event ingest at /api/<id>/
	#   /_allauth/     the headless auth endpoints Sentinel signs in through
	#   /accounts/     allauth's own views — the social callback URLs are
	#                  registered at the identity provider and cannot move
	#   /admin/        Django admin, which is the only way to reach a few
	#                  fields no API exposes (a status page's monitors)
	#   /oauth/        the authorisation endpoint for API clients
	#   /status-pages/ server-rendered, and staying that way while the API
	#                  has no per-page read to build our own from
	#   /static/ /media/  what those pages and admin are made of
	#   /stripe/       its billing webhook
	#   /v1/logs       OTLP ingest, which SDKs post to directly
	#   /metrics       Prometheus, when ENABLE_OBSERVABILITY_API is on. A
	#                  scraper handed an HTML shell fails quietly, which is
	#                  the worst way for monitoring to break.
	#   the odds and ends its urls.py puts at the root
	#
	# Each namespace is listed twice, with and without the trailing slash.
	# "/api/*" does not match "/api", and Django answers that one with a
	# redirect to "/api/" — a redirect that never happens if the request
	# stops here instead.
	@glitchtip path /api /api/* /_allauth /_allauth/* /accounts /accounts/* /oauth /oauth/* /status-pages /status-pages/* /static /static/* /media /media/* /stripe /stripe/* /admin /admin/* /v1/logs /v1/logs/ /metrics /_health /_health/ /robots.txt /favicon.ico
	handle @glitchtip {
		reverse_proxy glitchtip-web:8000
	}

	# One deep path that belongs to GlitchTip inside a namespace that does
	# not.
	#
	# "/organizations" is Sentinel's — it was the address of GlitchTip's
	# list-of-organisations screen and is this app's landing screen now — so
	# the namespace cannot be handed over wholesale. But one route under it
	# is a backend route: Sentinel-compatible clients ask for an event as
	# JSON at the Sentry-shaped address, and GlitchTip answers with a
	# redirect to the same thing under /api/0/. Routed to Sentinel it came
	# back as the app's own HTML, which a client parsing JSON reports as a
	# corrupt event rather than as a misrouted request.
	#
	# A regular expression rather than a path wildcard, because this needs
	# to match a shape rather than a prefix, and the shape is what keeps it
	# from swallowing the screens either side of it.
	@glitchtip_event_json path_regexp ^/organizations/[^/]+/issues/[^/]+/events/[^/]+/json/?$
	handle @glitchtip_event_json {
		reverse_proxy glitchtip-web:8000
	}

	# Everything else is Sentinel, at the root.
	#
	# This is the flip. The address people type is the app now rather than a
	# redirect to it, and GlitchTip's own UI routes — /<org>/issues,
	# /profile, /login, /accept/<id>/<token> — land here too, where the
	# client router recognises the old shapes and sends them to the screens
	# that replaced them. That is deliberately not done with rewrite rules up
	# here: the addresses are the client's, they need to move as the client
	# moves, and one router that knows all of them is easier to keep honest
	# than a second copy in a proxy config.
	#
	# /sentinel/ still works and is still tested. It was the address for
	# nine phases, people have it bookmarked, and the receiver serves both
	# mounts from the same shell.
	handle {
		reverse_proxy feedback-receiver:4000
	}

	encode gzip

	# A shell with no caching headers gets whatever heuristic the browser
	# feels like, which can be hours. Sentinel's shell is generated per
	# request and carries the mount and the CSRF cookie, so a stale one is
	# a signed-in person looking at a page that cannot write. Only HTML is
	# affected — hash-named JS and CSS keep whatever caching they came with.
	header {
		match {
			header Content-Type text/html*
		}
		Cache-Control "no-cache"
	}

	# Access log — the quickest way to answer "did the browser's event
	# actually reach the pipeline?" (`docker compose logs caddy`).
	log
}

:4000 {
	reverse_proxy feedback-receiver:4000
	encode gzip

	# Uploaded screenshot bundles can be a few MB; give the proxy headroom.
	request_body {
		max_size 10MB
	}

	log
}

# --- Once you have a real domain pointed at this server (optional) -------
#
# Replace the :8000 block above with this and Caddy will provision and renew
# TLS certificates automatically.
#
# This is the same routing, not a simpler one. It used to be two domains —
# one for GlitchTip's interface and one for Sentinel's — and that is what the
# flip removed: there is one interface now, and GlitchTip is a backend behind
# it. A domain that proxies everything to glitchtip-web serves an interface
# nothing links to any more, on an origin where Sentinel's own API is
# missing.
#
# Keep the two lists identical to the ones above. They are the whole
# contract between the backends, and a domain deployment that quietly drifts
# from the localhost one is the kind of difference that only shows up in
# production.
#
# sentinel.<domain> {
# 	@report_intake path /api/reports /api/reports/*
# 	handle @report_intake {
# 		reverse_proxy feedback-receiver:4000
# 	}
#
# 	@glitchtip path /api /api/* /_allauth /_allauth/* /accounts /accounts/* /oauth /oauth/* /status-pages /status-pages/* /static /static/* /media /media/* /stripe /stripe/* /admin /admin/* /v1/logs /v1/logs/ /metrics /_health /_health/ /robots.txt /favicon.ico
# 	handle @glitchtip {
# 		reverse_proxy glitchtip-web:8000
# 	}
#
# 	@glitchtip_event_json path_regexp ^/organizations/[^/]+/issues/[^/]+/events/[^/]+/json/?$
# 	handle @glitchtip_event_json {
# 		reverse_proxy glitchtip-web:8000
# 	}
#
# 	handle {
# 		reverse_proxy feedback-receiver:4000
# 	}
#
# 	encode gzip
# 	header {
# 		match {
# 			header Content-Type text/html*
# 		}
# 		Cache-Control "no-cache"
# 	}
# 	request_body {
# 		max_size 10MB
# 	}
# 	log
# }
#
# GLITCHTIP_DOMAIN must be https://sentinel.<domain> — GlitchTip builds DSNs
# from it, and an SDK given an http:// DSN for an https:// origin is blocked
# by the browser before it sends anything.
#
# The escape hatch is a second name rather than a path, for the reason
# docker-compose.yml gives: GlitchTip's shell declares <base href="/"> and
# its bundles are hash-named under /static/, so a sub-path would need every
# asset reference rewriting and its router would then disagree with the URL.
# Add it only while the hatch is open, and set GLITCHTIP_UI_URL to match.
#
# glitchtip.<domain> {
# 	reverse_proxy glitchtip-web:8000
# 	encode gzip
# }
#
# The :4000 block stays as it is. It is the same app on its own port, for
# the embedded viewer and for setups with no GlitchTip at all, and it is
# reached by apps rather than typed by people — so it needs no name.
