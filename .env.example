# Copy to .env and fill in real values. Never commit the real .env.

DOMAIN=example.org

# --- Postgres / GlitchTip ---
POSTGRES_PASSWORD=change-me
GLITCHTIP_SECRET_KEY=change-me-to-a-long-random-string
EMAIL_URL=smtp://user:pass@smtp.example.org:587
DEFAULT_FROM_EMAIL=errors@example.org

# --- Feedback / incident receiver ---
# Shared token every app's SDK/widget sends as `Authorization: Bearer <token>`.
STAFF_API_TOKEN=change-me-to-a-long-random-string
# Slack (or Slack-compatible) incoming webhook URL for new-report notifications.
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Comma-separated list of app origins allowed to POST reports.
ALLOWED_ORIGINS=https://app1.example.org,https://app2.example.org
