# Copy to .env and fill in real values. Never commit the real .env.
#
# Running locally right now? The defaults below already work as-is —
# just `docker compose up -d` and visit http://localhost:8000.
#
# Once you upload this to the server, change GLITCHTIP_DOMAIN and
# ALLOWED_ORIGINS to use the server's public IP instead of localhost
# (e.g. http://203.0.113.10:8000) — no domain/DNS needed either way.

# --- Postgres / GlitchTip ---
POSTGRES_PASSWORD=change-me
GLITCHTIP_SECRET_KEY=change-me-to-a-long-random-string
EMAIL_URL=smtp://user:pass@smtp.example.org:587
DEFAULT_FROM_EMAIL=errors@example.org
# Base URL GlitchTip uses to generate DSNs / links in emails.
GLITCHTIP_DOMAIN=http://localhost:8000

# --- Feedback / incident receiver ---
# Shared token every app's SDK/widget sends as `Authorization: Bearer <token>`.
STAFF_API_TOKEN=change-me-to-a-long-random-string
# Slack (or Slack-compatible) incoming webhook URL for new-report notifications.
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Who may read reports ---
# There is no user database. People sign in to the viewer with a personal
# GlitchTip auth token (GlitchTip > Profile > Auth Tokens), and the receiver
# asks GlitchTip whether that token belongs to a member of this organisation.
# So granting access is "invite them to the org", and removing them there
# removes it here. Leave GLITCHTIP_ORG empty to fall back to the shared
# STAFF_API_TOKEN as the only way in.
GLITCHTIP_ORG=your-org-slug
# Secret used to sign session cookies. Any long random string; changing it
# signs everyone out. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# How long a signed-in session lasts.
SESSION_HOURS=12
# Apps report under a name of their own choosing, which needn't match the
# GlitchTip project slug. Map one to the other so the viewer can link a
# report across to the same project's errors. JSON, on one line.
GLITCHTIP_PROJECT_MAP={"your-app":"your-glitchtip-project"}
# --- Retention ---
# Reports hold session replays and staff notes about real people's sessions,
# so they don't live forever. Both caps apply; set either to 0 to disable it.
# Delete reports older than this many days.
RETENTION_DAYS=90
# When the store grows past this many MB, delete oldest-first until it fits.
RETENTION_MAX_MB=5120
# How often to sweep, in minutes.
RETENTION_SWEEP_MINUTES=360

# Comma-separated list of app origins allowed to POST reports.
# Also controls which origins may embed the viewer in their own admin (CSP
# frame-ancestors).
# For local testing this is wherever the app you're integrating runs, e.g.:
ALLOWED_ORIGINS=http://localhost:3000
