# Copy to .env and fill in real values. Never commit the real .env.
#
# Running locally right now? The defaults below already work as-is —
# just `docker compose up -d` and visit http://localhost:8000.
#
# Once you upload this to the server, change GLITCHTIP_DOMAIN and
# ALLOWED_ORIGINS to use the server's public IP instead of localhost
# (e.g. http://203.0.113.10:8000) — no domain/DNS needed either way.

# --- Postgres / GlitchTip ---
POSTGRES_PASSWORD=change-me
GLITCHTIP_SECRET_KEY=change-me-to-a-long-random-string
EMAIL_URL=smtp://user:pass@smtp.example.org:587
DEFAULT_FROM_EMAIL=errors@example.org
# Base URL GlitchTip uses to generate DSNs / links in emails.
GLITCHTIP_DOMAIN=http://localhost:8000

# --- Feedback / incident receiver ---
# Shared token every app's SDK/widget sends as `Authorization: Bearer <token>`
# when it posts a report, and the token a host page hands to the embedded
# viewer. It is a machine credential, NOT a way for a person to sign in:
# client-rendered admin panels ship it in their bundle, so anyone who can
# open one can read it. People sign in with their own GlitchTip account (see
# below). Rotate it by changing it here and in each app's server-side config.
STAFF_API_TOKEN=change-me-to-a-long-random-string
# Slack (or Slack-compatible) incoming webhook URL for new-report notifications.
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Where staff reach Sentinel. Used by scripts/patch-glitchtip-index.sh, which
# bakes it into the link it adds to GlitchTip's UI; change it and re-run that
# script.
SENTINEL_URL=http://localhost:4000

# --- Who may read reports ---
# There is no user database: GlitchTip holds the accounts. Anyone signed in
# to GlitchTip in the same browser is signed in to the viewer automatically,
# and signing out of either signs them out of both. From a browser that
# isn't signed in, the viewer takes a personal GlitchTip auth token instead
# (GlitchTip > Profile > Auth Tokens, with the org:read scope ticked).
# Either way the receiver asks GlitchTip whether the account belongs to this
# organisation, so granting access is "invite them to the org" and removing
# them there removes it here. Leave GLITCHTIP_ORG empty only if you have no
# GlitchTip — then STAFF_API_TOKEN becomes the sign-in of last resort.
GLITCHTIP_ORG=your-org-slug
# Secret used to sign session cookies. Any long random string; changing it
# signs everyone out. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# How long a signed-in session lasts.
SESSION_HOURS=12
# --- Creating GlitchTip projects automatically ---
# Set these and the first report from a new app creates its GlitchTip
# project, reads back the DSN, and remembers the mapping — no project to
# create by hand, and the viewer shows each app its DSN.
#
# Make a dedicated GlitchTip account for this (call it Sentinel), give it
# the Admin role in the organisation — GlitchTip requires that to create a
# project, and no scope can substitute — then create its auth token with:
#
#     project:read, project:write, org:read
#
# Leave project:admin UNTICKED. Creating a project needs project:write and
# deleting one needs project:admin, so a token without it can add projects
# and never remove one. Note that scopes only bind token requests: don't
# sign in to GlitchTip as this account in a browser, where its Admin role
# applies in full.
GLITCHTIP_SERVICE_TOKEN=
# The team new projects are filed under (GlitchTip > Teams).
GLITCHTIP_TEAM=

# Apps report under a name of their own choosing, which needn't match the
# GlitchTip project slug. Anything set here wins over what Sentinel worked
# out for itself — use it for apps whose project already existed. JSON, on
# one line. Leave it empty if you set the two values above.
GLITCHTIP_PROJECT_MAP={}
# --- Retention ---
# Reports hold session replays and staff notes about real people's sessions,
# so they don't live forever. Both caps apply; set either to 0 to disable it.
# Delete reports older than this many days.
RETENTION_DAYS=90
# When the store grows past this many MB, delete oldest-first until it fits.
RETENTION_MAX_MB=5120
# How often to sweep, in minutes.
RETENTION_SWEEP_MINUTES=360

# Comma-separated list of app origins allowed to POST reports.
# Also controls which origins may embed the viewer in their own admin (CSP
# frame-ancestors).
# For local testing this is wherever the app you're integrating runs, e.g.:
ALLOWED_ORIGINS=http://localhost:3000
