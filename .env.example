# Copy to .env and fill in real values. Never commit the real .env.
#
# Running locally right now? The defaults below already work as-is —
# just `docker compose up -d` and visit http://localhost:8000.
#
# Once you upload this to the server, change GLITCHTIP_DOMAIN and
# ALLOWED_ORIGINS to use the server's public IP instead of localhost
# (e.g. http://203.0.113.10:8000) — no domain/DNS needed either way.

# --- Postgres / GlitchTip ---
POSTGRES_PASSWORD=change-me
GLITCHTIP_SECRET_KEY=change-me-to-a-long-random-string
EMAIL_URL=smtp://user:pass@smtp.example.org:587
DEFAULT_FROM_EMAIL=errors@example.org
# Base URL GlitchTip uses to generate DSNs / links in emails.
GLITCHTIP_DOMAIN=http://localhost:8000
# Two settings that sound alike. The first governs creating accounts, the
# second creating organisations.
#
# Leave registration on unless you have a reason not to: GlitchTip won't
# invite an email that has no account yet, so turning it off means you can
# only invite people who already registered — and nobody new can. An
# account on its own grants nothing; joining an organisation is what does,
# and only an existing member can invite someone to one.
ENABLE_USER_REGISTRATION=true
ENABLE_OPEN_USER_REGISTRATION=false
# Ports published on the host. Change these when something already occupies
# 8000 or 4000 — a shared server usually does. They must agree with
# GLITCHTIP_DOMAIN and SENTINEL_URL above, which is what apps and browsers
# actually connect to.
GLITCHTIP_PORT=8000
SENTINEL_PORT=4000

# --- Feedback / incident receiver ---
# Shared token every app's SDK/widget sends as `Authorization: Bearer <token>`
# when it posts a report, and the token a host page hands to the embedded
# viewer. It is a machine credential, NOT a way for a person to sign in:
# client-rendered admin panels ship it in their bundle, so anyone who can
# open one can read it. People sign in with their own GlitchTip account (see
# below). Rotate it by changing it here and in each app's server-side config.
STAFF_API_TOKEN=change-me-to-a-long-random-string
# Slack (or Slack-compatible) incoming webhook URL for new-report notifications.
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Where staff reach Sentinel. Used by scripts/patch-glitchtip-index.sh, which
# bakes it into the link it adds to GlitchTip's UI; change it and re-run that
# script.
SENTINEL_URL=http://localhost:4000

# --- Who may read reports ---
# Normally nothing here needs setting. Membership of any GlitchTip
# organisation gets someone in, and they see the apps whose GlitchTip project
# they can see — so an organisation per product or client works with no
# configuration at all. GLITCHTIP_ORG below is an optional narrowing, for a
# GlitchTip that also serves things other than this pipeline.
# Anyone signed in to GlitchTip in the same browser is signed in to the
# viewer automatically, and signing out of either signs them out of both.
# From a browser that isn't signed in, the viewer takes a personal GlitchTip
# auth token instead (GlitchTip > Profile > Auth Tokens, ticking org:read and
# project:read). Granting access is "invite them to the organisation";
# removing them there removes it here.
#
# Leave this empty unless you want to narrow access to one organisation.
# Someone who belongs only to a different organisation is treated as having
# none: they can ask for access, and can read nothing until granted it.
GLITCHTIP_ORG=

# SESSION_SECRET and SESSION_HOURS used to live here, for a session cookie
# Sentinel minted itself. There is one session now and GlitchTip owns it, so
# how long it lasts is the two settings below and nothing else.
#
# How long a sign-in lasts, in seconds, counted from signing in rather than
# from last use. GlitchTip's own default is 1209600 (14 days); this stack
# ships 604800 (7 days), because anyone holding a session can read every
# error and every session replay. Django enforces it, so it survives a
# restart of anything and is the bound that always applies.
SESSION_COOKIE_AGE=604800
#
# Optionally, sign out a session nobody has touched for this many minutes.
# Off by default: an idle timeout that fires while somebody is reading an
# issue is worse than not having one.
#
# Activity is reported by the browser, because it has to be — issues and
# projects are proxied straight to GlitchTip and never reach the receiver, so
# a timeout measured from what arrives there would sign out anyone who was
# only reading. That also means this protects an unattended machine rather
# than defending against the account's owner, who can keep their own session
# alive. Last-seen is held in memory, so restarting the receiver gives every
# session a fresh window.
SESSION_IDLE_MINUTES=0
#
# Both settings above bound *browser sessions*. They do not bound tokens, and
# for personal GlitchTip tokens nothing can: that model has no expiry field,
# so revoking one is the only way to end it. STAFF_API_TOKEN below has no
# issue date either — rotating it means changing it here and restarting.
#
# Without GLITCHTIP_URL set there is no account to sign in with and the
# viewer says so. STAFF_API_TOKEN still authenticates apps posting reports
# and the embedded viewer reading them, by header, with no session involved.
# Set to true only when TLS terminates in front of the receiver. It marks
# session cookies Secure, so a browser stops sending them over plain HTTP —
# which on a bare-IP deployment means nobody can sign in.
SECURE_COOKIES=false
# --- Creating GlitchTip projects automatically ---
# Set these and the first report from a new app creates its GlitchTip
# project, reads back the DSN, and remembers the mapping — no project to
# create by hand, and the viewer shows each app its DSN.
#
# Make a dedicated GlitchTip account for this (call it Sentinel), give it
# the Admin role in the organisation — GlitchTip requires that to create a
# project, and no scope can substitute — then create its auth token with:
#
#     project:read, project:write, org:read
#
# Leave project:admin UNTICKED. Creating a project needs project:write and
# deleting one needs project:admin, so a token without it can add projects
# and never remove one. Note that scopes only bind token requests: don't
# sign in to GlitchTip as this account in a browser, where its Admin role
# applies in full.
GLITCHTIP_SERVICE_TOKEN=
# The team new projects are filed under (GlitchTip > Teams).
GLITCHTIP_TEAM=

# Apps report under a name of their own choosing, which needn't match the
# GlitchTip project slug. Anything set here wins over what Sentinel worked
# out for itself — use it for apps whose project already existed. JSON, on
# one line. Leave it empty if you set the two values above.
GLITCHTIP_PROJECT_MAP={}
# --- Retention ---
# Reports hold session replays and staff notes about real people's sessions,
# so they don't live forever. Both caps apply; set either to 0 to disable it.
# Delete reports older than this many days.
RETENTION_DAYS=90
# When the store grows past this many MB, delete oldest-first until it fits.
RETENTION_MAX_MB=5120
# How often to sweep, in minutes.
RETENTION_SWEEP_MINUTES=360

# Comma-separated list of app origins allowed to POST reports.
# Also controls which origins may embed the viewer in their own admin (CSP
# frame-ancestors).
# For local testing this is wherever the app you're integrating runs, e.g.:
ALLOWED_ORIGINS=http://localhost:3000
